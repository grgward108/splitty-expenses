# このファイルを .mise.local.toml にコピーし、ローカル用の値を設定してください。
# .mise.local.toml は .gitignore されており、コミットされません。
#
# staging/production 用の変数は .mise.staging.local.toml.example / .mise.production.local.toml.example を参照してください。

[env]
POSTGRES_PASSWORD = "your_local_password_here"
DATABASE_URL = "postgresql://postgres:your_local_password_here@localhost:5432/app_dev"

# Better Auth（認証基盤）
# BETTER_AUTH_SECRET は32文字以上のランダム文字列を設定してください（例: openssl rand -base64 32）
BETTER_AUTH_SECRET = ""
BETTER_AUTH_URL = "http://localhost:3000"

# Google OAuth（Google でサインインする場合）
GOOGLE_CLIENT_ID = ""
GOOGLE_CLIENT_SECRET = ""

# --- Cloudflare デプロイ用 ---
# wrangler deploy に必要な認証情報
CLOUDFLARE_API_TOKEN = ""
CLOUDFLARE_ACCOUNT_ID = ""

# Hyperdrive 設定 ID（wrangler hyperdrive create で生成される）
# 例: wrangler hyperdrive create monorepo-db --connection-string="$DATABASE_URL"
# HYPERDRIVE_ID = ""
